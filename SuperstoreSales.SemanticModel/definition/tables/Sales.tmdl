table Sales

	column 'Row ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Row ID

	column 'Order ID'
		dataType: string
		summarizeBy: none
		sourceColumn: Order ID

	column 'Order Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		summarizeBy: none
		sourceColumn: Order Date

	column 'Ship Date'
		dataType: dateTime
		formatString: dd-mmm-yyyy
		summarizeBy: none
		sourceColumn: Ship Date

	column 'Ship Mode'
		dataType: string
		summarizeBy: none
		sourceColumn: Ship Mode

	column 'Customer ID'
		dataType: string
		summarizeBy: none
		sourceColumn: Customer ID

	column 'Customer Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Customer Name

	column Segment
		dataType: string
		summarizeBy: none
		sourceColumn: Segment

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	column City
		dataType: string
		summarizeBy: none
		sourceColumn: City

	column State
		dataType: string
		summarizeBy: none
		sourceColumn: State

	column 'Postal Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Postal Code

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

	column 'Product ID'
		dataType: string
		summarizeBy: none
		sourceColumn: Product ID

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column 'Sub-Category'
		dataType: string
		summarizeBy: none
		sourceColumn: Sub-Category

	column 'Product Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Product Name

	column Sales
		dataType: double
		formatString: \$#,0.00
		summarizeBy: none
		sourceColumn: Sales

	column 'Ship Days'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Ship Days

	measure 'Total Sales' = SUM(Sales[Sales])
		formatString: \$#,0
		displayFolder: 1 KPIs

	measure 'Total Orders' = DISTINCTCOUNT(Sales[Order ID])
		formatString: #,0
		displayFolder: 1 KPIs

	measure 'Total Customers' = DISTINCTCOUNT(Sales[Customer ID])
		formatString: #,0
		displayFolder: 1 KPIs

	measure 'Total Products' = DISTINCTCOUNT(Sales[Product ID])
		formatString: #,0
		displayFolder: 1 KPIs

	measure 'Line Items' = COUNTROWS(Sales)
		formatString: #,0
		displayFolder: 1 KPIs

	measure 'Avg Order Value' = DIVIDE([Total Sales], [Total Orders])
		formatString: \$#,0.00
		displayFolder: 1 KPIs

	measure 'Avg Sales per Customer' = DIVIDE([Total Sales], [Total Customers])
		formatString: \$#,0.00
		displayFolder: 1 KPIs

	measure 'Orders per Customer' = DIVIDE([Total Orders], [Total Customers])
		formatString: 0.00
		displayFolder: 1 KPIs

	measure 'Items per Order' = DIVIDE([Line Items], [Total Orders])
		formatString: 0.00
		displayFolder: 1 KPIs

	measure 'Avg Ship Days' = AVERAGE(Sales[Ship Days])
		formatString: 0.0
		displayFolder: 1 KPIs

	measure 'Largest Order' = MAXX(VALUES(Sales[Order ID]), CALCULATE(SUM(Sales[Sales])))
		formatString: \$#,0
		displayFolder: 1 KPIs

	measure 'Avg Monthly Sales' = AVERAGEX(VALUES('Calendar'[Year-Month]), [Total Sales])
		formatString: \$#,0
		displayFolder: 1 KPIs

	measure 'Sales CY' =
			VAR cy = MAX('Calendar'[Year])
			RETURN CALCULATE([Total Sales], ALL('Calendar'), 'Calendar'[Year] = cy)
		formatString: \$#,0
		displayFolder: 2 Growth

	measure 'Sales PY' =
			VAR cy = MAX('Calendar'[Year])
			RETURN CALCULATE([Total Sales], ALL('Calendar'), 'Calendar'[Year] = cy - 1)
		formatString: \$#,0
		displayFolder: 2 Growth

	measure 'YoY Growth %' = DIVIDE([Sales CY] - [Sales PY], [Sales PY])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2 Growth

	measure 'YoY Growth Amount' = [Sales CY] - [Sales PY]
		formatString: +\$#,0;-\$#,0;\$0
		displayFolder: 2 Growth

	measure 'Sales LY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: \$#,0
		displayFolder: 3 Time Intelligence

	measure 'Sales YoY % (period)' = DIVIDE([Total Sales] - [Sales LY], [Sales LY])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time Intelligence

	measure 'Sales PM' = CALCULATE([Total Sales], DATEADD('Calendar'[Date], -1, MONTH))
		formatString: \$#,0
		displayFolder: 3 Time Intelligence

	measure 'Sales MoM %' = DIVIDE([Total Sales] - [Sales PM], [Sales PM])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time Intelligence

	measure 'Sales YTD' = TOTALYTD([Total Sales], 'Calendar'[Date])
		formatString: \$#,0
		displayFolder: 3 Time Intelligence

	measure 'Sales YTD LY' = CALCULATE([Sales YTD], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: \$#,0
		displayFolder: 3 Time Intelligence

	measure 'Sales YTD YoY %' = DIVIDE([Sales YTD] - [Sales YTD LY], [Sales YTD LY])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Time Intelligence

	measure 'Rolling 3M Sales' = CALCULATE([Total Sales], DATESINPERIOD('Calendar'[Date], MAX('Calendar'[Date]), -3, MONTH))
		formatString: \$#,0
		displayFolder: 3 Time Intelligence

	measure '% of Total Sales' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED()))
		formatString: 0.0%
		displayFolder: 4 Ranking

	measure 'Product Rank' = RANKX(ALLSELECTED(Sales[Product Name]), [Total Sales], , DESC, DENSE)
		formatString: 0
		displayFolder: 4 Ranking

	measure 'Customer Rank' = RANKX(ALLSELECTED(Sales[Customer Name]), [Total Sales], , DESC, DENSE)
		formatString: 0
		displayFolder: 4 Ranking

	measure 'Top Category' = MAXX(TOPN(1, ALLSELECTED(Sales[Category]), [Total Sales], DESC), Sales[Category])
		displayFolder: 4 Ranking

	measure 'Top Sub-Category' = MAXX(TOPN(1, ALLSELECTED(Sales[Sub-Category]), [Total Sales], DESC), Sales[Sub-Category])
		displayFolder: 4 Ranking

	measure 'Top Region' = MAXX(TOPN(1, ALLSELECTED(Sales[Region]), [Total Sales], DESC), Sales[Region])
		displayFolder: 4 Ranking

	measure 'Top State' = MAXX(TOPN(1, ALLSELECTED(Sales[State]), [Total Sales], DESC), Sales[State])
		displayFolder: 4 Ranking

	measure 'Best Month' = MAXX(TOPN(1, ALLSELECTED('Calendar'[Year-Month]), [Total Sales], DESC), 'Calendar'[Year-Month])
		displayFolder: 4 Ranking

	measure 'Repeat Customers' = COUNTROWS(FILTER(VALUES(Sales[Customer ID]), CALCULATE(DISTINCTCOUNT(Sales[Order ID])) > 1))
		formatString: #,0
		displayFolder: 5 Customers

	measure 'Repeat Customer %' = DIVIDE([Repeat Customers], [Total Customers])
		formatString: 0.0%
		displayFolder: 5 Customers

	partition Sales = m
		mode: import
		source =
				let
					Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter = ",", Columns = 18, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					NoBlankPostal = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Postal Code"}),
					Typed = Table.TransformColumnTypes(NoBlankPostal, {{"Row ID", Int64.Type}, {"Order ID", type text}, {"Order Date", type date}, {"Ship Date", type date}, {"Ship Mode", type text}, {"Customer ID", type text}, {"Customer Name", type text}, {"Segment", type text}, {"Country", type text}, {"City", type text}, {"State", type text}, {"Postal Code", type text}, {"Region", type text}, {"Product ID", type text}, {"Category", type text}, {"Sub-Category", type text}, {"Product Name", type text}, {"Sales", type number}}, "en-GB"),
					ShipDays = Table.AddColumn(Typed, "Ship Days", each Duration.Days([Ship Date] - [Order Date]), Int64.Type)
				in
					ShipDays

	annotation PBI_ResultType = Table
