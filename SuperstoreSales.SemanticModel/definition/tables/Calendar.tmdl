table Calendar
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd-mmm-yyyy
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: [Quarter]

	column 'Month Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Number]

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	column Year-Month
		dataType: string
		summarizeBy: none
		sourceColumn: [Year-Month]

	column Year-Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: [Year-Quarter]

	column 'Weekday Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Weekday Number]

	column Weekday
		dataType: string
		summarizeBy: none
		sourceColumn: [Weekday]
		sortByColumn: 'Weekday Number'

	partition Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(YEAR(MIN(Sales[Order Date])), 1, 1), DATE(YEAR(MAX(Sales[Order Date])), 12, 31)),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & ROUNDUP(MONTH([Date]) / 3, 0),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Year-Quarter", YEAR([Date]) & "-Q" & ROUNDUP(MONTH([Date]) / 3, 0),
				    "Weekday Number", WEEKDAY([Date], 2),
				    "Weekday", FORMAT([Date], "ddd")
				)

	annotation PBI_ResultType = Table
